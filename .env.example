# A Dark Room — Server Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# In production, set these via your deployment platform (systemd, Docker, etc.).

# ── Required ─────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://adr:adarkroom_dev_pw@localhost:5432/adarkroom_dev

# JWT signing secret — generate with: openssl rand -hex 64
# The default value works for local development only.
# In production, this MUST be a strong random value.
JWT_SECRET=change-me-in-production

# ── Optional (defaults shown) ────────────────────────────

# HTTP server port
# PORT=3000

# WebSocket server port
# WS_PORT=3001

# CORS allowed origin (the URL where your game is served)
# CORS_ORIGIN=http://localhost:8080

# Environment: development | production | test
# NODE_ENV=development

# PostgreSQL connection pool size
# DB_POOL_SIZE=10

# JWT token expiry duration (vercel/ms format: 24h, 7d, 60m, etc.)
# JWT_TOKEN_EXPIRY=24h

# WebSocket heartbeat interval in milliseconds
# WS_HEARTBEAT_INTERVAL=30000
